# Copy to .env (same folder as docker-compose.yml) and fill in real values,
# then run: docker compose up -d --build

DB_NAME=nexus_crm
DB_PASSWORD=change_me_to_a_strong_password

JWT_SECRET=change_me_to_a_long_random_string
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Set these to your real domain(s) once you have one — until then the
# localhost defaults are fine for testing on a single machine/VM.
FRONTEND_URL=http://localhost
REACT_APP_API_URL=http://localhost:5000/api

# Optional integrations — leave blank to skip
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORTS_AUTO_EMAIL=false
