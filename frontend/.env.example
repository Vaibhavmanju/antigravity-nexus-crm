# Copy this file to .env for local dev.
# In production, set REACT_APP_API_URL as a build-time variable on your
# host (Vercel/Netlify project settings, or as a Docker build-arg) —
# Create React App inlines it into the static bundle at build time.

REACT_APP_API_URL=http://localhost:5000/api
DISABLE_ESLINT_PLUGIN=true
