# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it's already git-ignored.

# Server
PORT=5000
NODE_ENV=production

# MySQL Database
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=nexus_crm

# JWT Secret — generate a fresh long random string for every deployment,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin credentials (created automatically on first `npm run setup-db`)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Frontend URL (for CORS) — set to your deployed frontend's real origin
FRONTEND_URL=http://localhost:3000

# Google Sheets auto-sync
SHEET_AUTO_SYNC=true
SHEET_SYNC_INTERVAL_MINUTES=5

# ── Power BI Embedded (optional) ──────────────────────────────────
# Leave blank to keep the Power BI panel in "not configured" mode.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=
POWERBI_DATASET_ID=

# ── Automated report emails & alerts (optional) ───────────────────
# Leave SMTP_HOST blank to disable outgoing email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Antigravity Nexus CRM <no-reply@nexus-crm.local>"
REPORTS_AUTO_EMAIL=false
REPORTS_EMAIL_INTERVAL_HOURS=168

# ── Notification / target-check scheduler ─────────────────────────
NOTIFICATIONS_CHECK_INTERVAL_MINUTES=60

# ── Sheet Analytics ───────────────────────────────────────────────
# Business timezone used to decide what "today" / "this week" means.
APP_TIMEZONE=Asia/Kolkata
# When a user has no rows at all in a sheet (RFQ / Client / Project), show
# clearly-labelled sample data instead of an empty panel. Real synced data
# replaces it automatically. Set to false to always show real data only.
SAMPLE_DATA_FALLBACK=true
